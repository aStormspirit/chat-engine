# https://my.telegram.org/apps
API_ID=0
API_HASH=

# Where .session files are stored (one per account)
SESSIONS_DIR=sessions

# Accounts: either a JSON file...
# ACCOUNTS_FILE=accounts.json
# ...or inline JSON. If both are empty, a single account "default" is used.
# ACCOUNTS=[{"id":"main"},{"id":"second"}]

LOG_LEVEL=INFO

# FastAPI
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=["*"]

# Anonymous chat bot the userbot talks to
ANON_BOT_USERNAME=@AnonRuBot
ANON_SEARCH_COMMAND=/search
ANON_STOP_COMMAND=/stop
HISTORY_LIMIT=200

# docker compose: host port and image (APP_IMAGE is managed by deploy/deploy.sh)
# HOST_PORT=8000
# APP_IMAGE=<dockerhub-user>/chat-engine:latest
